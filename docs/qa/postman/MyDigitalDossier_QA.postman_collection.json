{
  "info": {
    "_postman_id": "b7b6f6f0-90ee-4d90-a9bb-f2d2e8a6de99",
    "name": "My Digital Dossier - QA Supabase REST Checks",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "QA-focused Postman collection for core Supabase REST checks: local signup (testing table), profile upsert/read, and project create/read."
  },
  "variable": [
    { "key": "supabaseUrl", "value": "https://YOUR_PROJECT.supabase.co" },
    { "key": "anonKey", "value": "YOUR_SUPABASE_ANON_KEY" },
    { "key": "username", "value": "qa_postman_user" },
    { "key": "fullName", "value": "QA Postman User" },
    { "key": "password", "value": "qa_test_123" },
    { "key": "projectName", "value": "QA Postman Project" },
    { "key": "createdProjectId", "value": "" }
  ],
  "item": [
    {
      "name": "1) Health Check - Read profile_settings",
      "request": {
        "method": "GET",
        "header": [
          { "key": "apikey", "value": "{{anonKey}}" },
          { "key": "Authorization", "value": "Bearer {{anonKey}}" }
        ],
        "url": {
          "raw": "{{supabaseUrl}}/rest/v1/profile_settings?select=username&limit=1",
          "host": ["{{supabaseUrl}}"],
          "path": ["rest", "v1", "profile_settings"],
          "query": [
            { "key": "select", "value": "username" },
            { "key": "limit", "value": "1" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2) Signup (testing) - Insert local_users",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{anonKey}}" },
          { "key": "Authorization", "value": "Bearer {{anonKey}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Prefer", "value": "return=representation" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"full_name\": \"{{fullName}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{supabaseUrl}}/rest/v1/local_users",
          "host": ["{{supabaseUrl}}"],
          "path": ["rest", "v1", "local_users"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201 or duplicate conflict 409', function () {",
              "  pm.expect([201, 409]).to.include(pm.response.code);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3) Upsert profile_settings",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{anonKey}}" },
          { "key": "Authorization", "value": "Bearer {{anonKey}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Prefer", "value": "resolution=merge-duplicates,return=representation" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"full_name\": \"{{fullName}}\",\n  \"role_title\": \"QA Engineer\",\n  \"tagline\": \"API and E2E quality checks\",\n  \"github_username\": \"{{username}}\"\n}"
        },
        "url": {
          "raw": "{{supabaseUrl}}/rest/v1/profile_settings?on_conflict=username",
          "host": ["{{supabaseUrl}}"],
          "path": ["rest", "v1", "profile_settings"],
          "query": [
            { "key": "on_conflict", "value": "username" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201 or 200', function () {",
              "  pm.expect([200, 201]).to.include(pm.response.code);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4) Get profile_settings by username",
      "request": {
        "method": "GET",
        "header": [
          { "key": "apikey", "value": "{{anonKey}}" },
          { "key": "Authorization", "value": "Bearer {{anonKey}}" }
        ],
        "url": {
          "raw": "{{supabaseUrl}}/rest/v1/profile_settings?username=eq.{{username}}&select=*",
          "host": ["{{supabaseUrl}}"],
          "path": ["rest", "v1", "profile_settings"],
          "query": [
            { "key": "username", "value": "eq.{{username}}" },
            { "key": "select", "value": "*" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const data = pm.response.json();",
              "pm.test('Profile exists for username', function () {",
              "  pm.expect(data.length).to.be.greaterThan(0);",
              "  pm.expect(data[0].username).to.eql(pm.collectionVariables.get('username'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5) Create project",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{anonKey}}" },
          { "key": "Authorization", "value": "Bearer {{anonKey}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Prefer", "value": "return=representation" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"name\": \"{{projectName}}\",\n  \"description\": \"Created from Postman QA collection\",\n  \"tech_stack\": \"Postman, Supabase REST\",\n  \"is_pinned\": true\n}"
        },
        "url": {
          "raw": "{{supabaseUrl}}/rest/v1/projects",
          "host": ["{{supabaseUrl}}"],
          "path": ["rest", "v1", "projects"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const data = pm.response.json();",
              "if (Array.isArray(data) && data.length > 0) {",
              "  pm.collectionVariables.set('createdProjectId', data[0].id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6) Get projects by username",
      "request": {
        "method": "GET",
        "header": [
          { "key": "apikey", "value": "{{anonKey}}" },
          { "key": "Authorization", "value": "Bearer {{anonKey}}" }
        ],
        "url": {
          "raw": "{{supabaseUrl}}/rest/v1/projects?username=eq.{{username}}&select=id,name,is_pinned,created_at&order=created_at.desc",
          "host": ["{{supabaseUrl}}"],
          "path": ["rest", "v1", "projects"],
          "query": [
            { "key": "username", "value": "eq.{{username}}" },
            { "key": "select", "value": "id,name,is_pinned,created_at" },
            { "key": "order", "value": "created_at.desc" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const data = pm.response.json();",
              "pm.test('At least one project exists for username', function () {",
              "  pm.expect(Array.isArray(data)).to.eql(true);",
              "  pm.expect(data.length).to.be.greaterThan(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
